rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: services
    // Fields:
    //   - title: string (required)
    //   - description: string (required)
    //   - price: string (required)
    //   - image: string (required)
    //   - category: string (optional)
    //
    // Collection: gallery
    // Fields:
    //   - imageUrl: string (required)
    //   - title: string (required)
    //   - category: string (optional)
    //
    // Collection: contact_requests
    // Fields:
    //   - name: string (required, < 100 chars)
    //   - phone: string (required, < 20 chars)
    //   - message: string (required, < 1000 chars)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "sukimhecker@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidService(data) {
      return data.keys().hasAll(['title', 'description', 'price', 'image']) &&
             data.title is string && data.title.size() < 100 &&
             data.description is string && data.description.size() < 1000 &&
             data.price is string && data.price.size() < 50 &&
             data.image is string && data.image.size() < 500;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['imageUrl', 'title']) &&
             data.imageUrl is string && data.imageUrl.size() < 500 &&
             data.title is string && data.title.size() < 100;
    }

    function isValidContactRequest(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'createdAt']) &&
             data.name is string && data.name.size() < 100 &&
             data.phone is string && data.phone.size() < 20 &&
             data.message is string && data.message.size() < 1000 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Services: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidService(request.resource.data);
    }

    // Gallery: Public read, Admin write
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidGalleryItem(request.resource.data);
    }

    // Contact Requests: Public create, Admin read/delete
    match /contact_requests/{requestId} {
      allow read, delete: if isAdmin();
      allow create: if isValidContactRequest(request.resource.data);
    }

    // User Profiles: Owner read/write, Admin read
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId;
    }
  }
}
